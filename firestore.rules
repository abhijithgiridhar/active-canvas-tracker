rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Roster: readable so the login screen can list names + check PINs.
    // Writable so the org dashboard's bulk-upload tool can add girls from
    // an Excel/CSV file — same pilot-grade trust model as entries below.
    match /girls/{girlId} {
      allow read, write: if true;
    }

    // Ledger entries: open read/write. There is no login system beyond a
    // name+PIN pair checked in the browser, so this is pilot-grade security —
    // fine for a trusted, known group of ~20 girls, not a public product.
    // See README.md "Security notes" before rolling this out more widely.
    match /entries/{entryId} {
      allow read, write: if true;
    }
  }
}
